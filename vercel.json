{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "crons": [
    {
      "path": "/api/cron/purge-consent-proofs",
      "schedule": "15 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://gym-easy.vercel.app"
        }
      ]
    },
    {
      "source": "/:path((?!api(?:/|$)).*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://gym-easy.vercel.app"
        }
      ]
    }
  ]
}
