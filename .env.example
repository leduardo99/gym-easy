# Server-only Postgres connection string from Neon.
# Use the pooled host for the app runtime and the direct host for migrations.
# Never prefix this variable with NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# The Coolify app defaults to smtp and talks to Mailpit on the docker network.
# EMAIL_TRANSPORT may be smtp, resend, or log. Resend is optional and needs
# RESEND_API_KEY only when selected. log records the kind, a redacted
# recipient, and an id. Test runs default to log.
# Never prefix these variables with NEXT_PUBLIC_.
SMTP_HOST=mailpit
SMTP_PORT=1025
# EMAIL_TRANSPORT=smtp
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Optional. Required only when EMAIL_TRANSPORT=resend.
# EMAIL_FROM defaults to Gym Easy <onboarding@resend.dev>.
# RESEND_API_KEY=
# EMAIL_FROM=Gym Easy <onboarding@resend.dev>

# Signs and encrypts the ge_confirm_email cookie. At least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Never prefix this variable with NEXT_PUBLIC_.
# CONFIRM_EMAIL_SECRET=

# Server-only HMAC key for the consent proof kept after account deletion.
# At least 32 characters. Generate a random value per environment.
# Required at runtime. `next build` accepts a placeholder when this is unset.
# Never prefix this variable with NEXT_PUBLIC_.
# CONSENT_PSEUDONYM_KEY=

# Bearer secret for GET /api/cron/purge-consent-proofs. At least 16 characters.
# Coolify sends Authorization: Bearer. Without it the route responds 401.
# Never prefix this variable with NEXT_PUBLIC_.
# CRON_SECRET=

# Optional fallback. The GitHub workflow is the migration path.
# Set this to true only if the container should migrate on start.
# RUN_MIGRATIONS=false
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
