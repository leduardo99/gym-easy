# Public origin of this app. Production is https://app.gaffer.pt.
# Email links and Access-Control-Allow-Origin use this value.
# Local compose defaults to http://127.0.0.1:3000 when it is unset.
# APP_URL=http://127.0.0.1:3000

# Shared homelab Postgres, internal network only, with TLS.
# Production uses sslmode=verify-full and NODE_EXTRA_CA_CERTS (default
# /etc/coolify-ca/coolify-ca.crt, override the variable to change the path).
# Neon stays as a fallback: the same URL shape with sslmode=require.
# Never prefix this variable with NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
# NODE_EXTRA_CA_CERTS=/etc/coolify-ca/coolify-ca.crt

# postgres.js pool. Integer from 5 to 10. Default 5.
# DB_POOL_MAX=5
# Idle timeout in seconds. Default 20.
# DB_IDLE_TIMEOUT=20
# Connect timeout in seconds. Default 10.
# DB_CONNECT_TIMEOUT=10
# Statement timeout in milliseconds. Default 15000.
# DB_STATEMENT_TIMEOUT=15000

# Production requires EMAIL_TRANSPORT=resend and RESEND_API_KEY.
# smtp and log are rejected when NODE_ENV=production.
# Dev profile only (`docker compose --profile dev`): smtp to Mailpit, no TLS.
# EMAIL_TRANSPORT=resend
# RESEND_API_KEY=
# EMAIL_FROM=Gym Easy <noreply@gaffer.pt>
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Signs and encrypts the ge_confirm_email cookie. At least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Never prefix this variable with NEXT_PUBLIC_.
# CONFIRM_EMAIL_SECRET=

# Server-only HMAC key for the consent proof kept after account deletion.
# At least 32 characters. Generate a random value per environment.
# Required at runtime. `next build` accepts a placeholder when this is unset.
# Never prefix this variable with NEXT_PUBLIC_.
# CONSENT_PSEUDONYM_KEY=

# Bearer secret for POST /api/cron/purge-consent-proofs. At least 32 characters.
# Coolify sends Authorization: Bearer. Required in production.
# Never prefix this variable with NEXT_PUBLIC_.
# CRON_SECRET=

# Behind the Coolify Traefik proxy, trust only the rightmost X-Forwarded-For hop.
# TRUST_PROXY=true
# TRUSTED_PROXY_HOPS=1

# Direct connection for migrations at container start. The user must be
# gym_easy_migrator. Not a pooled host. Production uses sslmode=verify-full
# with NODE_EXTRA_CA_CERTS. No real values here.
# DATABASE_URL_MIGRATOR=postgresql://gym_easy_migrator:PASSWORD@HOST/DATABASE?sslmode=verify-full

# When true, the container applies Drizzle migrations with DATABASE_URL_MIGRATOR
# inside a pg_advisory_lock, checks consent privileges, then starts the server.
# Failure exits non-zero. Required true on Coolify. Local compose may stay false.
# RUN_MIGRATIONS=true
