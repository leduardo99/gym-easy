# Server-only Postgres connection string from Neon.
# Use the pooled host for the app runtime and the direct host for migrations.
# Never prefix this variable with NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Production (Vercel): leave EMAIL_TRANSPORT unset. The default is resend
# and RESEND_API_KEY is required.
# Preview (Vercel): leave EMAIL_TRANSPORT unset. The default is log.
# No API key and no SMTP. The log records only the email kind, a redacted
# recipient, and an id.
# Dev on Coolify: docker-compose.yml sets EMAIL_TRANSPORT=smtp and
# SMTP_HOST=mailpit on the shared network. No host ports are published.
# Production smtp also needs SMTP_ALLOW_PRODUCTION=true.
# Never prefix these variables with NEXT_PUBLIC_.
SMTP_HOST=mailpit
SMTP_PORT=1025
# EMAIL_TRANSPORT=smtp
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_ALLOW_PRODUCTION=true

# Required in production, when the transport is resend.
# When the transport is log, auth emails are logged without the body, the
# confirmation link, the token, or the full address.
# EMAIL_FROM defaults to Gym Easy <onboarding@resend.dev>.
# RESEND_API_KEY=
# EMAIL_FROM=Gym Easy <onboarding@resend.dev>

# Signs and encrypts the ge_confirm_email cookie. At least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Never prefix this variable with NEXT_PUBLIC_.
# CONFIRM_EMAIL_SECRET=

# Server-only HMAC key for the consent proof kept after account deletion.
# At least 32 characters. Generate a random value per environment.
# Required at runtime. `next build` accepts a placeholder when this is unset.
# Never prefix this variable with NEXT_PUBLIC_.
# CONSENT_PSEUDONYM_KEY=

# Bearer secret for the daily consent-proof purge cron. Required in production.
# CRON_SECRET=
