# Server-only Postgres connection string from Neon.
# Use the pooled host for the app runtime and the direct host for migrations.
# Never prefix this variable with NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional. When RESEND_API_KEY is unset, auth emails are logged without
# addresses, links, or message bodies. Do not create a Resend account from
# the app. EMAIL_FROM defaults to Gym Easy <onboarding@resend.dev>.
# RESEND_API_KEY=
# EMAIL_FROM=Gym Easy <onboarding@resend.dev>

# Server-only HMAC key for the consent proof kept after account deletion.
# At least 32 characters. Generate a random value per environment.
# Required at runtime. `next build` accepts a placeholder when this is unset.
# Never prefix this variable with NEXT_PUBLIC_.
# CONSENT_PSEUDONYM_KEY=

# Bearer secret for the daily consent-proof purge cron. Required in production.
# CRON_SECRET=
